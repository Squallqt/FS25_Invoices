<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="InvoicesFrame">
    <GuiElement profile="baseReference">
        <GuiElement profile="fs25_menuContainer">

        <!-- Header -->
        <GuiElement profile="fs25_menuHeaderPanel" position="-62px 92px">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="invHeaderIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" text="$l10n_invoice_menu_title"/>
            <RoundCorner profile="fs25_shopMoneyBoxBg" id="shopMoneyBoxBg"/>
            <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
                <Text profile="fs25_shopBalance" text="$l10n_ui_balance:"/>
                <Text profile="fs25_shopMoney" id="currentBalanceText"/>
            </BoxLayout>
        </GuiElement>

        <!-- Tabs -->
        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[1]" text="$l10n_invoice_tab_incoming" onClick="onClickIncoming">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[2]" text="$l10n_invoice_tab_outgoing" onClick="onClickOutgoing">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
        </BoxLayout>

        <!-- Separator -->
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="-63px -57px" size="100% 2dp"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging" position="0px -10px" onClick="updateSubCategoryPages"/>

        <!-- Tab 1: Incoming -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[1]">

            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="-63px -48px" size="100% 1dp"/>
            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="-63px -723px" size="100% 1dp"/>

            <GuiElement id="invoiceListContainer" profile="invListContentArea">

                <!-- Column headers -->
                <GuiElement profile="fs25_statisticsHeaderBox" position="-63px 0px">
                    <TableHeader id="incomingSortHeaders[1]" profile="invColumnHeaderBtn" position="45px -14px" size="100px 32px" text="$l10n_invoice_col_number" targetTableId="listInvoices" columnName="number" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="incomingSortHeaders[2]" profile="invColumnHeaderBtn" position="155px -14px" size="170px 32px" text="$l10n_invoice_col_date" targetTableId="listInvoices" columnName="date" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="incomingSortHeaders[3]" profile="invColumnHeaderBtn" position="335px -14px" size="300px 32px" text="$l10n_invoice_col_farm" targetTableId="listInvoices" columnName="farm" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="incomingSortHeaders[4]" profile="invColumnHeaderBtn" position="675px -14px" size="310px 32px" text="$l10n_invoice_step4_col_service" targetTableId="listInvoices" columnName="services" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="incomingSortHeaders[5]" profile="invColumnHeaderBtn" position="1020px -14px" size="165px 32px" text="$l10n_invoice_col_status" targetTableId="listInvoices" columnName="status" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="incomingSortHeaders[7]" profile="invColumnHeaderBtn" position="1225px -14px" size="95px 32px" text="$l10n_invoice_label_discount" targetTableId="listInvoices" columnName="discount" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="incomingSortHeaders[6]" profile="invColumnHeaderBtn" position="1305px -14px" size="270px 32px" text="$l10n_invoice_col_amount" targetTableId="listInvoices" columnName="amount" allowSortingAsc="true" allowSortingDesc="true"/>
                    <Bitmap id="incomingSortIcons[1]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="incomingSortIcons[2]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="incomingSortIcons[3]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="incomingSortIcons[4]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="incomingSortIcons[5]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="incomingSortIcons[7]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="incomingSortIcons[6]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                </GuiElement>

                <!-- Invoice list -->
                <SmoothList id="listInvoices" profile="invInvoiceList" position="-63px -50px">
                    <ListItem profile="invInvoiceListItem">
                        <ThreePartBitmap profile="invListItemGradient" name="alternating"/>
                        <Text profile="invRowCellLeft"   position="45px 0px"   size="100px 32px" name="cellNumber"/>
                        <Text profile="invRowCellLeft"   position="155px 0px"  size="170px 32px" name="cellDate"/>
                        <Text profile="invRowCellLeft"   position="335px 0px"  size="300px 32px" name="cellFarm"/>
                        <Text profile="invRowCellDim"    position="675px 0px"  size="310px 32px" name="cellServices"/>
                        <Text profile="invRowCellCenter" position="1020px 0px" size="165px 32px" name="cellStatus"/>
                        <Text profile="invRowCellCenter" position="1225px 0px" size="95px 32px" name="cellDiscount"/>
                        <Text profile="invRowCellRight"  position="1305px 0px" size="270px 32px" name="cellAmount"/>
                    </ListItem>
                </SmoothList>

            </GuiElement>

            <!-- Empty state -->
            <GuiElement id="emptyListContainer" profile="invListContentArea">
                <Text profile="invEmptyStateText" id="emptyStateText" position="540px -350px" text="$l10n_invoice_empty_list"/>
            </GuiElement>

        </GuiElement>

        <!-- Tab 2: Outgoing -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[2]">

            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="-63px -48px" size="100% 1dp"/>
            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="-63px -723px" size="100% 1dp"/>

            <GuiElement id="invoiceListContainer2" profile="invListContentArea">

                <!-- Column headers -->
                <GuiElement profile="fs25_statisticsHeaderBox" position="-63px 0px">
                    <TableHeader id="outgoingSortHeaders[1]" profile="invColumnHeaderBtn" position="45px -14px" size="100px 32px" text="$l10n_invoice_col_number" targetTableId="listInvoices2" columnName="number" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="outgoingSortHeaders[2]" profile="invColumnHeaderBtn" position="155px -14px" size="170px 32px" text="$l10n_invoice_col_date" targetTableId="listInvoices2" columnName="date" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="outgoingSortHeaders[3]" profile="invColumnHeaderBtn" position="335px -14px" size="300px 32px" text="$l10n_invoice_col_farm" targetTableId="listInvoices2" columnName="farm" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="outgoingSortHeaders[4]" profile="invColumnHeaderBtn" position="675px -14px" size="310px 32px" text="$l10n_invoice_step4_col_service" targetTableId="listInvoices2" columnName="services" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="outgoingSortHeaders[5]" profile="invColumnHeaderBtn" position="1020px -14px" size="165px 32px" text="$l10n_invoice_col_status" targetTableId="listInvoices2" columnName="status" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="outgoingSortHeaders[7]" profile="invColumnHeaderBtn" position="1225px -14px" size="95px 32px" text="$l10n_invoice_label_discount" targetTableId="listInvoices2" columnName="discount" allowSortingAsc="true" allowSortingDesc="true"/>
                    <TableHeader id="outgoingSortHeaders[6]" profile="invColumnHeaderBtn" position="1305px -14px" size="270px 32px" text="$l10n_invoice_col_amount" targetTableId="listInvoices2" columnName="amount" allowSortingAsc="true" allowSortingDesc="true"/>
                    <Bitmap id="outgoingSortIcons[1]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="outgoingSortIcons[2]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="outgoingSortIcons[3]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="outgoingSortIcons[4]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="outgoingSortIcons[5]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="outgoingSortIcons[7]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                    <Bitmap id="outgoingSortIcons[6]" profile="invSortArrowIcon" position="0px 0px" visible="false"/>
                </GuiElement>

                <!-- Invoice list -->
                <SmoothList id="listInvoices2" profile="invInvoiceList" position="-63px -50px">
                    <ListItem profile="invInvoiceListItem">
                        <ThreePartBitmap profile="invListItemGradient" name="alternating"/>
                        <Text profile="invRowCellLeft"   position="45px 0px"   size="100px 32px" name="cellNumber"/>
                        <Text profile="invRowCellLeft"   position="155px 0px"  size="170px 32px" name="cellDate"/>
                        <Text profile="invRowCellLeft"   position="335px 0px"  size="300px 32px" name="cellFarm"/>
                        <Text profile="invRowCellDim"    position="675px 0px"  size="310px 32px" name="cellServices"/>
                        <Text profile="invRowCellCenter" position="1020px 0px" size="165px 32px" name="cellStatus"/>
                        <Text profile="invRowCellCenter" position="1225px 0px" size="95px 32px" name="cellDiscount"/>
                        <Text profile="invRowCellRight"  position="1305px 0px" size="270px 32px" name="cellAmount"/>
                    </ListItem>
                </SmoothList>

            </GuiElement>

            <!-- Empty state -->
            <GuiElement id="emptyListContainer2" profile="invListContentArea">
                <Text profile="invEmptyStateText" id="emptyStateText2" position="540px -350px" text="$l10n_invoice_empty_list"/>
            </GuiElement>

        </GuiElement>

        <!-- Docked sliders are menu-level controls, not part of the table layout. -->
        <ThreePartBitmap profile="invSliderDockedBg" id="invoiceSliderBox">
            <ThreePartBitmap profile="invSliderDockedBox">
                <Slider profile="invSliderDocked" id="invoiceSlider" dataElementId="listInvoices"/>
            </ThreePartBitmap>
        </ThreePartBitmap>

        <ThreePartBitmap profile="invSliderDockedBg" id="invoiceSliderBox2" visible="false">
            <ThreePartBitmap profile="invSliderDockedBox">
                <Slider profile="invSliderDocked" id="invoiceSlider2" dataElementId="listInvoices2"/>
            </ThreePartBitmap>
        </ThreePartBitmap>

        </GuiElement>
    </GuiElement>
</GUI>
