<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="940px 1070px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
        <ThreePartBitmap profile="fs25_dialogBgTop"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="fs25_dialogContentContainer">
            <BoxLayout profile="dashMainBox">

                <!-- Title -->
                <Text profile="dashMainTitle" text="$l10n_invoice_wizard_mainTitle" id="mainTitleText"/>
                <GuiElement profile="dashTitleSepWrapper">
                    <ThreePartBitmap profile="dashTitleSep" id="titleSep"/>
                </GuiElement>
                <GuiElement profile="dashTitleSpacer"/>

                <!-- Content area (absolute positioning) -->
                <GuiElement profile="dashContentArea">

                    <!-- ==================== SELECTION ==================== -->

                    <GuiElement profile="dashSelectionZone">

                        <!-- Column 1: Customer / Issuer -->
                        <GuiElement profile="dashColWrapper" position="0px 0px" size="268px 384px">
                            <RoundCorner profile="dashSelectionCardBg"/>
                            <Bitmap profile="dashCardHeaderBg"/>
                            <GuiElement profile="dashCardHeader">
                                <RoundCorner profile="dashCardBadgeBg"/>
                                <Text profile="dashCardBadgeText" text="01"/>
                                <Text profile="dashCardTitleText" text="$l10n_invoice_wizard_step1_label" id="textColFarm"/>
                            </GuiElement>
                            <GuiElement profile="dashCardListAreaWide">
                                <SmoothList profile="dashColListWide" id="listFarms" listItemSpacing="0px" onClick="onFarmListClicked" selectedWithoutFocus="false">
                                    <ListItem profile="dashSelectListItemFlat" name="farmTemplate">
                                        <Text profile="dashSelectDot" name="cellDot" text="·"/>
                                        <Text profile="dashSelectPrefix" name="cellPrefix"/>
                                        <Bitmap profile="dashSelectCheck" name="cellCheck"/>
                                        <Text profile="dashFarmCellName" name="cellName"/>
                                    </ListItem>
                                </SmoothList>
                            </GuiElement>
                        </GuiElement>

                        <!-- Column 2: Work types -->
                        <GuiElement profile="dashColWrapper" position="282px 0px" size="268px 384px" id="workTypesZone">
                            <RoundCorner profile="dashSelectionCardBg"/>
                            <Bitmap profile="dashCardHeaderBg"/>
                            <GuiElement profile="dashCardHeader">
                                <RoundCorner profile="dashCardBadgeBg"/>
                                <Text profile="dashCardBadgeText" text="02"/>
                                <Text profile="dashCardTitleText" text="$l10n_invoice_wizard_step2_label"/>
                            </GuiElement>
                            <GuiElement profile="dashCardListArea">
                                <SmoothList profile="dashColList" id="listWorkTypes" listItemSpacing="0px" onClick="onWorkTypeListClicked" selectedWithoutFocus="false">
                                    <ListItem profile="dashSelectListItemFlat" name="workTypeTemplate">
                                        <Text profile="dashSelectDot" name="cellDot" text="·"/>
                                        <Text profile="dashSelectPrefix" name="cellPrefix"/>
                                        <Bitmap profile="dashSelectCheck" name="cellCheck"/>
                                        <Text profile="dashWorkCellName" name="cellName"/>
                                        <Text profile="dashWorkCellPrice" name="cellPrice"/>
                                    </ListItem>
                                </SmoothList>
                            </GuiElement>
                            <ThreePartBitmap profile="dashSliderBox" position="254px -56px" size="6px 316px" id="workSliderBox">
                                <Slider profile="fs25_listSlider" size="6px 316px" dataElementId="listWorkTypes"/>
                            </ThreePartBitmap>
                        </GuiElement>

                        <!-- Column 3: Fields -->
                        <GuiElement profile="dashColWrapper" position="564px 0px" size="268px 384px" id="fieldsPanel">
                            <RoundCorner profile="dashSelectionCardBg"/>
                            <Bitmap profile="dashCardHeaderBg"/>
                            <GuiElement profile="dashCardHeader">
                                <RoundCorner profile="dashCardBadgeBg"/>
                                <Text profile="dashCardBadgeText" text="03"/>
                                <Text profile="dashCardTitleText" text="$l10n_invoice_wizard_step3_label"/>
                            </GuiElement>
                            <GuiElement profile="dashCardListArea">
                                <SmoothList profile="dashColList" id="listFields" listItemSpacing="0px" listSectionHeader="section" onClick="onFieldListClicked" selectedWithoutFocus="false">
                                    <ListItem profile="dashSelectListItemFlat" name="fieldTemplate">
                                        <Text profile="dashSelectDot" name="cellDot" text="·"/>
                                        <Text profile="dashSelectPrefix" name="cellPrefix"/>
                                        <Bitmap profile="dashSelectCheck" name="cellCheck"/>
                                        <Text profile="dashColFieldCellName" name="cellName"/>
                                        <Text profile="dashColFieldCellArea" name="cellArea"/>
                                    </ListItem>
                                    <ListItem profile="dashSectionHeader" name="section">
                                        <Button profile="dashSectionTitleBubble" name="title">
                                            <RoundCorner profile="dashSectionBubbleBg"/>
                                        </Button>
                                    </ListItem>
                                </SmoothList>
                                <Text profile="dashFieldsEmptyText" id="fieldsEmptyText" text="$l10n_invoice_dash_no_fields"/>
                            </GuiElement>
                            <ThreePartBitmap profile="dashSliderBox" position="254px -56px" size="6px 316px" id="fieldSliderBox">
                                <Slider profile="fs25_listSlider" size="6px 316px" dataElementId="listFields"/>
