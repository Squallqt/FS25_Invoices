            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="dashBtnRemove" id="btnRemove" text="$l10n_invoice_action_remove" onClick="onClickRemove" disabled="true"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="dashBtnRename" id="btnRename" text="$l10n_invoice_action_rename" onClick="onClickRename" disabled="true"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="dashBtnCancel" id="btnCancel" text="$l10n_invoice_btn_cancel" onClick="onClickCancel"/>
